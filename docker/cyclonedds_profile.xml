<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="wlo1"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Internal>
      <!-- Large image messages: bigger socket buffer (capped by net.core.rmem_max). See README for Wi-Fi capacity. -->
      <SocketReceiveBufferSize min="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
